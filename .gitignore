# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Environment / secrets — only .env.example should ever be committed
.env
.env.*
!.env.example

# Chrome extension packaging — the .pem is the PRIVATE signing key for
# this extension's ID; if it's ever committed, anyone who gets it can
# publish updates impersonating this extension. Never commit it.
*.pem
*.crx
*.zip

# Vite's dependency pre-bundle cache (also covered by node_modules, but
# explicit in case it's ever generated somewhere outside it)
.vite

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage output
coverage

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db