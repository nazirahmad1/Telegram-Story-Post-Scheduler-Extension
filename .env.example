# Copy this file to .env.local (already gitignored) and fill in your OWN
# credentials from https://my.telegram.org/apps
#
# NEVER put real values in THIS file (.env.example) — it is meant to be
# committed/shared as a template. Only .env.local (gitignored) should ever
# contain real credentials.

VITE_TELEGRAM_API_ID=your_api_id_here
VITE_TELEGRAM_API_HASH=your_api_hash_here
